# Copy to scripts/deploy.env and fill in your own server.
# That file is git-ignored: your addresses stay on your machine.

# Where to deploy. Anything ssh understands.
FITNESS_HOST="root@203.0.113.10"

# Address the app listens on. Keep it off 0.0.0.0 unless you mean to be
# reachable from the whole internet.
FITNESS_BIND="127.0.0.1"

FITNESS_PORT="8770"

# Printed when the deploy finishes, so you can click straight through.
FITNESS_URL="https://your-app.example.com"
